# Thin wrapper around the official OpenSign server image.
# Bakes deployment defaults so the Railway template deploys with zero
# required variables. All values can still be overridden with service
# variables on Railway.
FROM opensign/opensignserver@sha256:674fa8393122cb550d5c2fa4ddae5e13989387f27d63db98e6c23272849a551e

# Local volume storage instead of S3 (code defaults to S3 when unset)
ENV USE_LOCAL=true

# Parse Server app identity (code defaults exist but are pinned for clarity)
ENV APP_ID=opensign
ENV PARSE_MOUNT=/app

# Shared self-signed signing certificate so signing works out of the box.
# Users should upload their own certificate per organization for production.
ENV PASS_PHRASE=opensign
ENV PFX_
